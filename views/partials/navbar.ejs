<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
  <div class="container-fluid px-4">
    <a class="navbar-brand fw-bold text-primary" href="/proyectos">
      <i class="bi bi-kanban-fill me-2"></i>IssueTracker
    </a>
    <div class="d-flex align-items-center gap-3">
      <span class="text-secondary small" id="nav-usuario"></span>
      
      <button type="button" class="btn btn-outline-danger btn-sm" onclick="logout()">
        <i class="bi bi-box-arrow-right me-1"></i>Salir
      </button>
    </div>
  </div>
</nav>

<script>
  (function() {
    const usuarioString = localStorage.getItem('usuario');
    if (usuarioString) {
      try {
        const usuario = JSON.parse(usuarioString);
        const navUserEl = document.getElementById('nav-usuario');
        if (navUserEl) navUserEl.innerText = usuario.nombre || '';
      } catch (e) {
        console.error("Error al parsear el usuario:", e);
      }
    }

    window.logout = function() {
      console.log("Cerrando sesión...");
      localStorage.removeItem('token');
      localStorage.removeItem('usuario');
      window.location.href = '/login';
    };


    if (!localStorage.getItem('token')) {
      window.location.href = '/login';
    }
  })();
</script>