<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mis Proyectos — IssueTracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background-color: #0d1117; color: #e6edf3; }
    .navbar { background-color: #161b22 !important; border-bottom: 1px solid #30363d; }
    .card { background-color: #161b22; border: 1px solid #30363d; transition: border-color .2s; cursor: pointer; }
    .card:hover { border-color: #1f6feb; }
    .form-control, .form-select { background-color: #0d1117; border-color: #30363d; color: #e6edf3; }
    .form-control:focus, .form-select:focus { background-color: #0d1117; border-color: #1f6feb; color: #e6edf3; box-shadow: none; }
    .modal-content { background-color: #161b22; border: 1px solid #30363d; color: #e6edf3; }
    .modal-header, .modal-footer { border-color: #30363d; }
    .btn-primary { background-color: #1f6feb; border-color: #1f6feb; }
    .btn-primary:hover { background-color: #388bfd; border-color: #388bfd; }
    .badge-tickets { background-color: #21262d; color: #8b949e; font-size: .75rem; }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold mb-0">Mis Proyectos</h4>
        <p class="text-secondary small mb-0">Proyectos a los que pertenecés</p>
      </div>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalCrear">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Proyecto
      </button>
    </div>

    <div class="row g-3" id="lista-proyectos">
      <!-- Se carga dinámicamente -->
    </div>

    <div id="empty-state" class="text-center py-5 d-none">
      <i class="bi bi-folder-x fs-1 text-secondary"></i>
      <p class="text-secondary mt-2">No tenés proyectos todavía. ¡Creá uno!</p>
    </div>
  </div>

  <!-- Modal Crear Proyecto -->
  <div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Nuevo Proyecto</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger small d-none" id="modal-error"></div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Nombre *</label>
            <input type="text" id="nuevo-nombre" class="form-control" placeholder="Nombre del proyecto"/>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Descripción</label>
            <textarea id="nuevo-desc" class="form-control" rows="3" placeholder="Descripción opcional"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary btn-sm" onclick="crearProyecto()">Crear</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const token = localStorage.getItem('token');

    async function cargarProyectos() {
      const res = await fetch('/api/proyectos', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const proyectos = await res.json();
      const lista = document.getElementById('lista-proyectos');
      const empty = document.getElementById('empty-state');

      if (!proyectos.length) { empty.classList.remove('d-none'); return; }

      lista.innerHTML = proyectos.map(p => `
        <div class="col-md-4">
          <div class="card p-4 h-100" onclick="window.location.href='/proyectos/${p.id}'">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h6 class="fw-bold mb-0">${p.nombre}</h6>
              <i class="bi bi-folder text-primary"></i>
            </div>
            <p class="text-secondary small mb-3">${p.descripcion || 'Sin descripción'}</p>
            <div class="mt-auto d-flex justify-content-between align-items-center">
              <span class="badge badge-tickets px-2 py-1">
                <i class="bi bi-calendar3 me-1"></i>${new Date(p.fecha_creacion).toLocaleDateString('es')}
              </span>
              <a href="/proyectos/${p.id}/tablero" class="btn btn-outline-primary btn-sm"
                 onclick="event.stopPropagation()">
                <i class="bi bi-kanban me-1"></i>Tablero
              </a>
            </div>
          </div>
        </div>
      `).join('');
    }

    async function crearProyecto() {
      const nombre = document.getElementById('nuevo-nombre').value.trim();
      const descripcion = document.getElementById('nuevo-desc').value.trim();
      const errorEl = document.getElementById('modal-error');
      errorEl.classList.add('d-none');

      if (!nombre) {
        errorEl.textContent = 'El nombre es requerido';
        errorEl.classList.remove('d-none');
        return;
      }

      const res = await fetch('/api/proyectos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ nombre, descripcion }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error;
        errorEl.classList.remove('d-none');
        return;
      }

      bootstrap.Modal.getInstance(document.getElementById('modalCrear')).hide();
      document.getElementById('nuevo-nombre').value = '';
      document.getElementById('nuevo-desc').value = '';
      cargarProyectos();
    }

    cargarProyectos();
  </script>
</body>
</html>