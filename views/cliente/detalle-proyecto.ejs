<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Proyecto — IssueTracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background-color: #0d1117; color: #e6edf3; }
    .navbar { background-color: #161b22 !important; border-bottom: 1px solid #30363d; }
    .card { background-color: #161b22; border: 1px solid #30363d; }
    .form-control { background-color: #0d1117; border-color: #30363d; color: #e6edf3; }
    .form-control:focus { background-color: #0d1117; border-color: #1f6feb; color: #e6edf3; box-shadow: none; }
    .modal-content { background-color: #161b22; border: 1px solid #30363d; color: #e6edf3; }
    .modal-header, .modal-footer { border-color: #30363d; }
    .btn-primary { background-color: #1f6feb; border-color: #1f6feb; }
    .btn-primary:hover { background-color: #388bfd; border-color: #388bfd; }
    .list-group-item { background-color: #21262d; border-color: #30363d; color: #e6edf3; }
    .badge-pendiente { background-color: #3d1f00; color: #e3b341; }
    .badge-en_progreso { background-color: #0c2d6b; color: #79c0ff; }
    .badge-completado { background-color: #0d3321; color: #56d364; }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="container py-5">

    <!-- Header del proyecto -->
    <div class="d-flex justify-content-between align-items-start mb-4" id="proyecto-header">
      <div>
        <a href="/proyectos" class="text-secondary small text-decoration-none">
          <i class="bi bi-arrow-left me-1"></i>Mis proyectos
        </a>
        <h4 class="fw-bold mt-1 mb-0" id="proyecto-nombre">Cargando...</h4>
        <p class="text-secondary small" id="proyecto-desc"></p>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditar">
          <i class="bi bi-pencil me-1"></i>Editar
        </button>
        <a id="btn-tablero" href="#" class="btn btn-primary btn-sm">
          <i class="bi bi-kanban me-1"></i>Ver Tablero
        </a>
      </div>
    </div>

    <div class="row g-4">
      <!-- Tickets -->
      <div class="col-lg-8">
        <div class="card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Tickets</h6>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalTicket">
              <i class="bi bi-plus-lg me-1"></i>Nuevo Ticket
            </button>
          </div>
          <div id="lista-tickets">
            <p class="text-secondary small text-center py-3">Cargando tickets...</p>
          </div>
        </div>
      </div>

      <!-- Miembros -->
      <div class="col-lg-4">
        <div class="card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Miembros</h6>
            <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalMiembro">
              <i class="bi bi-person-plus"></i>
            </button>
          </div>
          <ul class="list-group list-group-flush" id="lista-miembros"></ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Editar Proyecto -->
  <div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Editar Proyecto</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-secondary">Nombre *</label>
            <input type="text" id="edit-nombre" class="form-control"/>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Descripción</label>
            <textarea id="edit-desc" class="form-control" rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary btn-sm" onclick="editarProyecto()">Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Nuevo Ticket -->
  <div class="modal fade" id="modalTicket" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Nuevo Ticket</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger small d-none" id="ticket-error"></div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Título *</label>
            <input type="text" id="ticket-titulo" class="form-control"/>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Descripción *</label>
            <textarea id="ticket-desc" class="form-control" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Asignar a (opcional)</label>
            <select id="ticket-asignado" class="form-select" style="background-color:#0d1117;border-color:#30363d;color:#e6edf3;">
              <option value="">Sin asignar</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary btn-sm" onclick="crearTicket()">Crear</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Agregar Miembro -->
  <div class="modal fade" id="modalMiembro" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Agregar Miembro</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger small d-none" id="miembro-error"></div>
          <label class="form-label small text-secondary">ID del usuario</label>
          <input type="number" id="miembro-id" class="form-control" placeholder="ID del usuario"/>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary btn-sm" onclick="agregarMiembro()">Agregar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const token = localStorage.getItem('token');
    const proyectoId = window.location.pathname.split('/')[2];

    const badgeClase = { pendiente: 'badge-pendiente', en_progreso: 'badge-en_progreso', completado: 'badge-completado' };
    const badgeLabel = { pendiente: 'Pendiente', en_progreso: 'En Progreso', completado: 'Completado' };

    async function cargarProyecto() {
      const res = await fetch(`/api/proyectos/${proyectoId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const p = await res.json();

      document.getElementById('proyecto-nombre').textContent = p.nombre;
      document.getElementById('proyecto-desc').textContent = p.descripcion || '';
      document.getElementById('btn-tablero').href = `/proyectos/${proyectoId}/tablero`;
      document.getElementById('edit-nombre').value = p.nombre;
      document.getElementById('edit-desc').value = p.descripcion || '';

      // Miembros
      const lista = document.getElementById('lista-miembros');
      lista.innerHTML = p.miembros.map(m => `
        <li class="list-group-item d-flex align-items-center gap-2 px-0 border-0 py-2">
          <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center"
               style="width:32px;height:32px;font-size:.8rem;flex-shrink:0;">
            ${m.nombre.charAt(0).toUpperCase()}
          </div>
          <div>
            <div class="small fw-semibold">${m.nombre}</div>
            <div class="text-secondary" style="font-size:.75rem;">${m.email}</div>
          </div>
        </li>
      `).join('');

      // Opciones del select de asignado
      const select = document.getElementById('ticket-asignado');
      select.innerHTML = '<option value="">Sin asignar</option>' +
        p.miembros.map(m => `<option value="${m.id}">${m.nombre}</option>`).join('');
    }

    async function cargarTickets() {
      const res = await fetch(`/api/proyectos/${proyectoId}/tickets`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const tickets = await res.json();
      const lista = document.getElementById('lista-tickets');

      if (!tickets.length) {
        lista.innerHTML = '<p class="text-secondary small text-center py-3">No hay tickets todavía</p>';
        return;
      }

      lista.innerHTML = tickets.map(t => `
        <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary"
             style="cursor:pointer;" onclick="window.location.href='/proyectos/${proyectoId}/tickets/${t.id}'">
          <div>
            <span class="small fw-semibold">${t.titulo}</span>
            <div class="text-secondary" style="font-size:.75rem;">
              ${t.asignado ? `<i class="bi bi-person me-1"></i>${t.asignado.nombre}` : 'Sin asignar'}
            </div>
          </div>
          <span class="badge ${badgeClase[t.estado]} px-2 py-1">${badgeLabel[t.estado]}</span>
        </div>
      `).join('');
    }

    async function editarProyecto() {
      const nombre = document.getElementById('edit-nombre').value.trim();
      const descripcion = document.getElementById('edit-desc').value.trim();
      if (!nombre) return;

      await fetch(`/api/proyectos/${proyectoId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ nombre, descripcion }),
      });
      bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
      cargarProyecto();
    }

    async function crearTicket() {
      const titulo = document.getElementById('ticket-titulo').value.trim();
      const descripcion = document.getElementById('ticket-desc').value.trim();
      const usuario_asignado_id = document.getElementById('ticket-asignado').value || null;
      const errorEl = document.getElementById('ticket-error');
      errorEl.classList.add('d-none');

      if (!titulo || !descripcion) {
        errorEl.textContent = 'Título y descripción son requeridos';
        errorEl.classList.remove('d-none');
        return;
      }

      const res = await fetch(`/api/proyectos/${proyectoId}/tickets`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ titulo, descripcion, usuario_asignado_id }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error;
        errorEl.classList.remove('d-none');
        return;
      }

      bootstrap.Modal.getInstance(document.getElementById('modalTicket')).hide();
      document.getElementById('ticket-titulo').value = '';
      document.getElementById('ticket-desc').value = '';
      cargarTickets();
    }

    async function agregarMiembro() {
      const usuario_id = document.getElementById('miembro-id').value;
      const errorEl = document.getElementById('miembro-error');
      errorEl.classList.add('d-none');

      if (!usuario_id) {
        errorEl.textContent = 'Ingresá un ID de usuario';
        errorEl.classList.remove('d-none');
        return;
      }

      const res = await fetch(`/api/proyectos/${proyectoId}/usuarios`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ usuario_id }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error;
        errorEl.classList.remove('d-none');
        return;
      }

      bootstrap.Modal.getInstance(document.getElementById('modalMiembro')).hide();
      cargarProyecto();
    }

    cargarProyecto();
    cargarTickets();
  </script>
</body>
</html>