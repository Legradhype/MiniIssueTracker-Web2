<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ticket — IssueTracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    body { background-color: #0d1117; color: #e6edf3; }
    .navbar { background-color: #161b22 !important; border-bottom: 1px solid #30363d; }
    .card { background-color: #161b22; border: 1px solid #30363d; }
    .form-control, .form-select { background-color: #0d1117; border-color: #30363d; color: #e6edf3; }
    .form-control:focus, .form-select:focus { background-color: #0d1117; border-color: #1f6feb; color: #e6edf3; box-shadow: none; }
    .btn-primary { background-color: #1f6feb; border-color: #1f6feb; }
    .btn-primary:hover { background-color: #388bfd; border-color: #388bfd; }
    .badge-pendiente { background-color: #3d1f00; color: #e3b341; font-size:.85rem; }
    .badge-en_progreso { background-color: #0c2d6b; color: #79c0ff; font-size:.85rem; }
    .badge-completado { background-color: #0d3321; color: #56d364; font-size:.85rem; }
    .modal-content { background-color: #161b22; border: 1px solid #30363d; color: #e6edf3; }
    .modal-header, .modal-footer { border-color: #30363d; }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="container py-5" style="max-width:760px;">

    <a id="back-link" href="#" class="text-secondary small text-decoration-none">
      <i class="bi bi-arrow-left me-1"></i>Volver al proyecto
    </a>

    <div class="card p-4 mt-3" id="ticket-contenido">
      <p class="text-secondary small">Cargando...</p>
    </div>

  </div>

  <!-- Modal Editar Ticket -->
  <div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Editar Ticket</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-secondary">Título *</label>
            <input type="text" id="edit-titulo" class="form-control"/>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Descripción *</label>
            <textarea id="edit-desc" class="form-control" rows="4"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label small text-secondary">Asignado a</label>
            <select id="edit-asignado" class="form-select"></select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-primary btn-sm" onclick="guardarEdicion()">Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const token = localStorage.getItem('token');
    const partes = window.location.pathname.split('/');
    const proyectoId = partes[2];
    const ticketId = partes[4];

    document.getElementById('back-link').href = `/proyectos/${proyectoId}`;

    const badgeClase = { pendiente: 'badge-pendiente', en_progreso: 'badge-en_progreso', completado: 'badge-completado' };
    const badgeLabel = { pendiente: 'Pendiente', en_progreso: 'En Progreso', completado: 'Completado' };
    const TRANSICIONES = { pendiente: ['en_progreso'], en_progreso: ['pendiente', 'completado'], completado: ['en_progreso'] };

    let ticketActual = null;
    let miembros = [];

    async function cargarTicket() {
      const [resTicket, resProyecto] = await Promise.all([
        fetch(`/api/proyectos/${proyectoId}/tickets/${ticketId}`, { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch(`/api/proyectos/${proyectoId}`, { headers: { 'Authorization': `Bearer ${token}` } }),
      ]);

      ticketActual = await resTicket.json();
      const proyecto = await resProyecto.json();
      miembros = proyecto.miembros;

      renderTicket();
    }

    function renderTicket() {
      const t = ticketActual;
      const transiciones = TRANSICIONES[t.estado] || [];

      document.getElementById('ticket-contenido').innerHTML = `
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h5 class="fw-bold mb-0">${t.titulo}</h5>
          <span class="badge ${badgeClase[t.estado]} px-3 py-2">${badgeLabel[t.estado]}</span>
        </div>

        <p class="text-secondary">${t.descripcion || 'Sin descripción'}</p>

        <hr class="border-secondary"/>

        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <p class="text-secondary small mb-1">Asignado a</p>
            <p class="fw-semibold mb-0">${t.asignado ? t.asignado.nombre : 'Sin asignar'}</p>
          </div>
          <div class="col-sm-6">
            <p class="text-secondary small mb-1">Fecha de creación</p>
            <p class="fw-semibold mb-0">${new Date(t.fecha_creacion).toLocaleDateString('es')}</p>
          </div>
        </div>

        <!-- Cambiar estado -->
        <div class="d-flex flex-wrap gap-2 mb-4">
          ${transiciones.map(estado => `
            <button class="btn btn-outline-secondary btn-sm" onclick="cambiarEstado('${estado}')">
              Mover a <strong>${badgeLabel[estado]}</strong>
            </button>
          `).join('')}
        </div>

        <hr class="border-secondary"/>

        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-outline-primary btn-sm" onclick="abrirEdicion()">
            <i class="bi bi-pencil me-1"></i>Editar
          </button>
          <button class="btn btn-outline-danger btn-sm" onclick="eliminarTicket()">
            <i class="bi bi-trash me-1"></i>Eliminar
          </button>
        </div>
      `;
    }

    async function cambiarEstado(nuevo_estado) {
      const res = await fetch(`/api/proyectos/${proyectoId}/tickets/${ticketId}/estado`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ nuevo_estado }),
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error); return; }
      ticketActual = data;
      renderTicket();
    }

    function abrirEdicion() {
      document.getElementById('edit-titulo').value = ticketActual.titulo;
      document.getElementById('edit-desc').value = ticketActual.descripcion || '';

      const select = document.getElementById('edit-asignado');
      select.innerHTML = '<option value="">Sin asignar</option>' +
        miembros.map(m => `<option value="${m.id}" ${m.id === ticketActual.usuario_asignado_id ? 'selected' : ''}>${m.nombre}</option>`).join('');

      new bootstrap.Modal(document.getElementById('modalEditar')).show();
    }

    async function guardarEdicion() {
      const titulo = document.getElementById('edit-titulo').value.trim();
      const descripcion = document.getElementById('edit-desc').value.trim();
      const usuario_asignado_id = document.getElementById('edit-asignado').value || null;

      if (!titulo || !descripcion) { alert('Título y descripción son requeridos'); return; }

      const res = await fetch(`/api/proyectos/${proyectoId}/tickets/${ticketId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ titulo, descripcion, usuario_asignado_id }),
      });
      const data = await res.json();
      ticketActual = data;
      bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
      renderTicket();
    }

    async function eliminarTicket() {
      if (!confirm('¿Eliminar este ticket?')) return;
      await fetch(`/api/proyectos/${proyectoId}/tickets/${ticketId}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      window.location.href = `/proyectos/${proyectoId}`;
    }

    cargarTicket();
  </script>
</body>
</html>